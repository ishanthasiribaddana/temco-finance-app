# WildFly CLI script to configure MariaDB datasource
# This script is embedded but not auto-executed - datasource config via persistence.xml

# Add MariaDB driver
/subsystem=datasources/jdbc-driver=mariadb:add(driver-name=mariadb,driver-module-name=org.mariadb,driver-class-name=org.mariadb.jdbc.Driver)

# Add datasource
data-source add \
    --name=TemcoDS \
    --jndi-name=java:jboss/datasources/TemcoDS \
    --driver-name=mariadb \
    --connection-url=jdbc:mariadb://${env.DB_HOST:host.docker.internal}:${env.DB_PORT:3306}/${env.DB_NAME:temco_system} \
    --user-name=${env.DB_USER:temco_user} \
    --password=${env.DB_PASSWORD:temco123} \
    --min-pool-size=5 \
    --max-pool-size=20 \
    --enabled=true
