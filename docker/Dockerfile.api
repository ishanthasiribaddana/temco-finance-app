# =============================================================================
# FINANCE APP API SERVER - Node.js
# =============================================================================
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY api-server/package*.json ./

# Install production dependencies only
RUN npm ci --only=production

# Copy source code
COPY api-server/server.js ./

# Environment variables (can be overridden)
ENV NODE_ENV=production
ENV DB_HOST=host.docker.internal
ENV DB_PORT=3306
ENV DB_USER=root
ENV DB_PASSWORD=temco123
ENV DB_NAME=temco_system
ENV PORT=8086

# Expose port
EXPOSE 8086

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8086/api/health || exit 1

# Start the server
CMD ["node", "server.js"]
