# WildFly 26.1.3 with Java 17 for Temco Finance API
FROM quay.io/wildfly/wildfly:26.1.3.Final-jdk17

# Set environment variables
ENV DB_HOST=host.docker.internal \
    DB_PORT=3306 \
    DB_NAME=temco_system \
    DB_USER=temco_user \
    DB_PASSWORD=temco123

# Create MariaDB module directory
USER root
RUN mkdir -p /opt/jboss/wildfly/modules/org/mariadb/main
COPY docker/mariadb-java-client-3.1.4.jar /opt/jboss/wildfly/modules/org/mariadb/main/
COPY docker/module.xml /opt/jboss/wildfly/modules/org/mariadb/main/
RUN chown -R jboss:jboss /opt/jboss/wildfly/modules/org/mariadb
USER jboss

# Copy and run CLI script to configure datasource at build time
COPY --chown=jboss:jboss docker/configure-datasource.cli /tmp/configure-datasource.cli
RUN /opt/jboss/wildfly/bin/jboss-cli.sh --file=/tmp/configure-datasource.cli

# Copy the WAR file
COPY --chown=jboss:jboss temco-api/target/temco-api.war /opt/jboss/wildfly/standalone/deployments/

# Expose ports
EXPOSE 8080 9990

# Health check - increased start period for WildFly boot
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:8080/temco-api/api/health || exit 1

# Start WildFly
CMD ["/opt/jboss/wildfly/bin/standalone.sh", "-b", "0.0.0.0", "-bmanagement", "0.0.0.0"]
