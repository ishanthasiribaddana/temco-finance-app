# =============================================================================
# TEMCO Finance System - Environment Variables
# =============================================================================
# Copy this file to .env and update values as needed.
# These are only used when NOT relying on Vite proxy (e.g., Docker builds).
# For local dev with `npm run dev`, the Vite proxy handles API routing.
# =============================================================================

# Auth API URL (temco-loan-system SSO on WildFly)
VITE_AUTH_API_URL=http://localhost:8080/temco-loan-system/api/v1/customer

# Finance API URL (temco-api on Docker/WildFly)
VITE_API_URL=http://localhost:8087/temco-api/api
